PRIVATE_KEY=0x_your_private_key_here
MARKET_QUESTION=Will Bitcoin close above $100k this quarter?
# Paste bytecode from Remix here (or pass as BYTECODE env var)
BYTECODE=

# --- sweep-to-treasury.mjs ---
# Казна, куда свипим балансы:
TREASURY=0xD138925168aD03fEe0Cca73cD949F1077C82c093
# Приватные ключи кошельков для свипа, через запятую (НЕ коммитить реальные!):
SWEEP_KEYS=0xkey1,0xkey2
# Свипить только кошельки с балансом >= этого (USDC):
MIN_SWEEP_USDC=20
# (опц.) RPC; по умолчанию берётся дефолтный Arc Testnet:
# ARC_RPC_URL=https://rpc.testnet.arc.network
